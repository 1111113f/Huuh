local TELEPORT_DELAY = 0.15

local function findCheckpointsFolder()
    local possibleNames = {
        "Checkpoints", "Checkpoint", "Stages", "Stage", "Levels", "Level",
        "Spawns", "Spawn", "Check", "Points", "StageFolder", "LevelFolder",
        "CheckPointFolder", "StageParts", "CheckParts", "StagesFolder",
        "CheckpointsFolder", "Obby", "Towers", "Floors", "Zones",
        "CHECKPOINTS", "STAGES", "LEVELS"
    }
    
    for _, name in ipairs(possibleNames) do
        local folder = workspace:FindFirstChild(name)
        if folder and (folder:IsA("Folder") or folder:IsA("Model")) then
            for _, child in pairs(folder:GetChildren()) do
                if tonumber(child.Name) then
                    return folder
                end
            end
        end
    end
    
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("Folder") or obj:IsA("Model") then
            local nameLower = obj.Name:lower()
            if nameLower:find("checkpoint") or nameLower:find("stage") or 
               nameLower:find("level") or nameLower:find("spawn") or
               nameLower:find("obby") or nameLower:find("tower") then
                for _, child in pairs(obj:GetChildren()) do
                    if tonumber(child.Name) then
                        return obj
                    end
                end
            end
        end
    end
    
    local bestFolder = nil
    local maxNumbered = 0
    
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("Folder") or obj:IsA("Model") then
            local numberedCount = 0
            for _, child in pairs(obj:GetChildren()) do
                if tonumber(child.Name) and (child:IsA("BasePart") or child:IsA("Model")) then
                    numberedCount = numberedCount + 1
                end
            end
            if numberedCount > maxNumbered and numberedCount >= 3 then
                maxNumbered = numberedCount
                bestFolder = obj
            end
        end
    end
    
    return bestFolder
end

local function findStageValue()
    local leaderstats = player:FindFirstChild("leaderstats")
    if leaderstats then
        for _, stat in pairs(leaderstats:GetChildren()) do
            local name = stat.Name:lower()
            if (name:find("stage") or name:find("level") or name:find("checkpoint")) and stat:IsA("ValueBase") then
                return stat
            end
        end
    end
    
    for _, obj in pairs(player:GetChildren()) do
        if obj:IsA("ValueBase") then
            local name = obj.Name:lower()
            if name:find("stage") or name:find("level") or name:find("checkpoint") then
                return obj
            end
        end
    end
    
    return nil
end

local function findMaxCheckpoint(folder)
    local maxNum = 0
    local minNum = math.huge
    
    for _, obj in pairs(folder:GetChildren()) do
        local num = tonumber(obj.Name)
        if num then
            if num > maxNum then maxNum = num end
            if num < minNum then minNum = num end
        end
    end
    
    return maxNum, minNum
end

local CHECKPOINTS_FOLDER = findCheckpointsFolder()
if not CHECKPOINTS_FOLDER then
    warn("❌ Папка с чекпоинтами не найдена!")
    return
end

local stageValue = findStageValue()
local currentStage = stageValue and stageValue.Value or 1

local MAX_CHECKPOINT, MIN_CHECKPOINT = findMaxCheckpoint(CHECKPOINTS_FOLDER)
print("✅ Найдено: " .. CHECKPOINTS_FOLDER:GetFullName())
print("🎯 Чекпоинтов: " .. MIN_CHECKPOINT .. " - " .. MAX_CHECKPOINT)
print("📍 Текущий: " .. currentStage)

local function getCheckpoint(number)
    return CHECKPOINTS_FOLDER:FindFirstChild(tostring(number))
end

local function teleportTo(checkpoint)
    if not checkpoint or not hrp then return false end
    if checkpoint:IsA("Model") then
        local primary = checkpoint:FindFirstChildWhichIsA("BasePart")
        if primary then
            hrp.CFrame = primary.CFrame + Vector3.new(0, 5, 0)
            return true
        end
    elseif checkpoint:IsA("BasePart") then
        hrp.CFrame = checkpoint.CFrame + Vector3.new(0, 5, 0)
        return true
    end
    return false
end

local isTeleporting = false

local function teleportToEnd()
    if isTeleporting then return end
    
    if stageValue then
        currentStage = stageValue.Value or currentStage
    end
    
    local startStage = currentStage
    if startStage < MIN_CHECKPOINT then startStage = MIN_CHECKPOINT end
    if startStage >= MAX_CHECKPOINT then
        print("✅ Уже на максимуме!")
        return
    end
    
    isTeleporting = true
    print("🚀 Телепорт: " .. startStage .. " → " .. MAX_CHECKPOINT)
    
    for i = startStage, MAX_CHECKPOINT do
        local checkpoint = getCheckpoint(i)
        
        if checkpoint then
            teleportTo(checkpoint)
            if stageValue then stageValue.Value = i end
            
            if i % 5 == 0 or i == MAX_CHECKPOINT then
                print("  ✅ " .. i .. "/" .. MAX_CHECKPOINT)
            end
            
            if i < MAX_CHECKPOINT then
                task.wait(TELEPORT_DELAY)
            end
        else
            warn("  ⚠️ Не найден: " .. i)
        end
    end
    
    print("🎉 Готово!")
    isTeleporting = false
end

