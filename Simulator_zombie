TopBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        startPos = MainFrame.Position
    end
end)

TopBar.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = false
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement and dragStart and startPos then
        local delta = input.Position - dragStart
        MainFrame.Position = UDim2.new(
            startPos.X.Scale,
            startPos.X.Offset + delta.X,
            startPos.Y.Scale,
            startPos.Y.Offset + delta.Y
        )
    end
end)

local brainButtons = {}

local function createBrainButton(name)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -10, 0, 40)
    btn.BackgroundColor3 = Color3.fromRGB(50, 50, 55)
    btn.Text = name:gsub("_Pickup", ""):gsub("Brain", "")
    btn.TextColor3 = Color3.new(1, 1, 1)
    btn.Font = Enum.Font.Gotham
    btn.TextSize = 14
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.Parent = BrainFrame
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = btn
    
    local indicator = Instance.new("Frame")
    indicator.Size = UDim2.new(0, 8, 0, 8)
    indicator.Position = UDim2.new(1, -18, 0.5, -4)
    indicator.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
    indicator.BorderSizePixel = 0
    indicator.Parent = btn
    
    local indCorner = Instance.new("UICorner")
    indCorner.CornerRadius = UDim.new(1, 0)
    indCorner.Parent = indicator
    
    brainButtons[name] = {Button = btn, Indicator = indicator}
    
    btn.MouseButton1Click:Connect(function()
        local part = workspace:FindFirstChild(name, true)
        if part and part:IsA("MeshPart") then
            HumanoidRootPart.CFrame = part.CFrame + Vector3.new(0, 3, 0)
        end
    end)
end

for _, name in ipairs(brainNames) do
    createBrainButton(name)
end

spawn(function()
    while ScreenGui.Parent do
        for name, data in pairs(brainButtons) do
            local part = workspace:FindFirstChild(name, true)
            if part and part:IsA("MeshPart") then
                data.Indicator.BackgroundColor3 = Color3.fromRGB(0, 255, 100)
                data.Button.BackgroundColor3 = Color3.fromRGB(40, 80, 60)
            else
                data.Indicator.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
                data.Button.BackgroundColor3 = Color3.fromRGB(50, 50, 55)
            end
        end
        wait(2)
    end
end)

local energyRunning = false
local energyCollected = 0
local hoverConnection = nil

local function enableHover()
    if hoverConnection then return end
    hoverConnection = RunService.Heartbeat:Connect(function()
        if not energyRunning or not HumanoidRootPart then return end
        HumanoidRootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        for _, part in pairs(Character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
        if Humanoid then
            Humanoid.PlatformStand = true
        end
    end)
end

local function disableHover()
    if hoverConnection then
        hoverConnection:Disconnect()
        hoverConnection = nil
    end
    for _, part in pairs(Character:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = true
        end
    end
    if Humanoid then
        Humanoid.PlatformStand = false
    end
end

local function findNearestEnergy()
    local nearest = nil
    local minDist = math.huge
    local myPos = HumanoidRootPart.Position
    
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("MeshPart") and obj.Name == "Energy" and obj.Parent then
            local dist = (obj.Position - myPos).Magnitude
            if dist < minDist then
                minDist = dist
                nearest = obj
            end
        end
    end
    return nearest
end

local function energyLoop()
    enableHover()
    
    while energyRunning do
        if not Character or not HumanoidRootPart then
            Character = Player.Character or Player.CharacterAdded:Wait()
            HumanoidRootPart = Character:WaitForChild("HumanoidRootPart")
            Humanoid = Character:WaitForChild("Humanoid")
            enableHover()
            wait(0.5)
        end
        
        local energy = findNearestEnergy()
        
        if energy then
            EnergyStatus.Text = "COLLECTING"
            EnergyStatus.TextColor3 = Color3.fromRGB(0, 255, 100)
            
            HumanoidRootPart.CFrame = CFrame.new(energy.Position)
            
            local clickDetector = energy:FindFirstChildOfClass("ClickDetector")
            
            while energy.Parent and energyRunning do
                HumanoidRootPart.CFrame = CFrame.new(energy.Position)
                if clickDetector then
                    fireclickdetector(clickDetector)
                end
                wait(0.05)
            end
            
            energyCollected = energyCollected + 1
            EnergyStats.Text = "Collected: " .. energyCollected
            wait(0.1)
        else
            EnergyStatus.Text = "SEARCHING"
            EnergyStatus.TextColor3 = Color3.fromRGB(255, 170, 0)
            wait(0.2)
        end
    end
    
    disableHover()
    EnergyStatus.Text = "Status: Idle"
    EnergyStatus.TextColor3 = Color3.fromRGB(200, 200, 200)
end

local clickerRunning = false
local totalClicks = 0

local function getEquippedTool()
    if not Character then return nil end
    for _, child in pairs(Character:GetChildren()) do
        if child:IsA("Tool") then
            return child
        end
    end
    return nil
end

local function clickerLoop()
    while clickerRunning do
        local tool = getEquippedTool()
        
        if tool then
            ToolStatus.Text = "Tool: " .. tool.Name
            ToolStatus.TextColor3 = Color3.fromRGB(0, 255, 100)
            ClickerStatus.Text = "Auto Clicker: ON"
            ClickerStatus.TextColor3 = Color3.fromRGB(0, 255, 100)
            
            VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 1)
            wait(0.01)
            VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 1)
            tool:Activate()
            
            totalClicks = totalClicks + 1
            ClickStats.Text = "Clicks: " .. totalClicks
        else
            ToolStatus.Text = "Equip any tool!"
            ToolStatus.TextColor3 = Color3.fromRGB(255, 170, 0)
            ClickerStatus.Text = "Waiting for tool..."
            ClickerStatus.TextColor3 = Color3.fromRGB(255, 170, 0)
        end
        
        local interval = tonumber(ClickSpeedBox.Text) or 50
        wait(interval / 1000)
    end
    
    ClickerStatus.Text = "Auto Clicker: OFF"
    ClickerStatus.TextColor3 = Color3.fromRGB(200, 200, 200)
    ToolStatus.Text = "Equip any tool"
    ToolStatus.TextColor3 = Color3.fromRGB(150, 150, 150)
end

